# Образец файла с паролями. Скопируйте его: cp .env.example .env, и поменяйте пароли.
# Файл .env в git не попадает (см. .gitignore), в репозитории лежит только этот образец.
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
# Порт на вашем компьютере. Если 5432 занят другим PostgreSQL, укажите 5433.
DB_PORT=5432

# Лаба 4: пароли ролей приложения. Скрипт db/..._roles.sql читает их через \getenv
APP_READER_PASSWORD=change-me-reader
APP_WRITER_PASSWORD=change-me-writer
